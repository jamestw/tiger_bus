# Copy this to .env.prod on the VPS (never commit .env.prod)

POSTGRES_USER=tiger_bus
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tiger_bus

# Host is the "postgres" service name (containers share the tigerbus_network)
DATABASE_URL=postgresql://tiger_bus:CHANGE_ME@postgres:5432/tiger_bus

AUTH_SECRET=CHANGE_ME_LONG_RANDOM_STRING
AUTH_URL=https://tigerbus.aerocars.cc
AUTH_TRUST_HOST=true

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# Used once by scripts/seed-prod.ts to bootstrap the first SUPERADMIN account
SUPERADMIN_EMAIL=superadmin@tigerbus.dev
SUPERADMIN_PASSWORD=CHANGE_ME
SUPERADMIN_NAME=Super Admin
